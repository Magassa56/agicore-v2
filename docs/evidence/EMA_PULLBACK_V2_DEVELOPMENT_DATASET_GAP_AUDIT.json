:"SATURDAY_CLOSED","classification":"OBSERVED_ROW_OUTSIDE_PUBLISHED_SESSION_UNRESOLVED","derived_row_one_based":14701,"parent_row_one_based":26821,"row_preserved_unchanged":true,"timestamp_chicago":"2026-07-04T09:40:00-05:00","timestamp_utc":"2026-07-04T14:40:00Z"}],"off_session_provenance_review":{"blocking":false,"calendar_reason":"SATURDAY_CLOSED","classification":"UNRESOLVED_OFF_SESSION_STORED_DATA_PRESERVED","derived_row_one_based":14701,"exact_origin_proven":false,"manual_parent_row_modification_denied":true,"nonblocking_basis":["Explicit human instruction requires preservation and honest unresolved off-session stored-data classification, without requiring an invented exact mechanism.","Frozen DEVELOPMENT protocol requires explicit real gaps, timestamp/DST semantics, identity and structural checks; it does not require every stored row to be a regular-session bar.","The strategy has no session filter; lineage classification adds no strategic filter and changes no RAW byte."],"parent_row_one_based":26821,"particular_provider_cache_mechanism":null,"regular_CME_session_bar":false,"row_preserved_unchanged":true,"source_chain_human_attested":true,"source_provenance_evidence":{"path":"docs/evidence/EMA_PULLBACK_V2_DEVELOPMENT_DATASET_PROVENANCE_ATTESTATION.json","sha256":"0ee487a4217c6aeabdf64f8108aca1e0cc1a3a0d209afec9140fefd52bbd4f50"},"timestamp_chicago":"2026-07-04T09:40:00-05:00","timestamp_utc":"2026-07-04T14:40:00Z"},"off_session_row_policy":"Preserve the observed row unchanged as unresolved off-session stored data. It is not a valid regular CME session bar. Its precise provider/cache mechanism remains unproven; no deletion, correction, additional filter or claim of regular-session validity is made.","original_readonly_audit_source_and_findings_preserved":true,"parent_and_derived_bytes_unchanged":true,"parent_raw_sha256":"6e20320e06184673c745c1069753c77151fdccd4505b863210f6d63f3ff5fcd5","phase":"EMA_PULLBACK_V2_DEVELOPMENT_DATASET_LINEAGE","previous_gap_audit_sha256":"386650569726c6f46a650a2eb16ff679264d7a2e3fedd7eae93f967c5eaf7005","provenance_review_completed_at_utc":"2026-10-09T17:41:32.304085Z","raw_reread_during_provenance_review":false,"readonly_audit_source_sha256":"5b86ed4c9137a851562b3964e9047f8774c88f49afd0c3ea6944f5a6fe9780a1","readonly_audit_source_utf8":"\"\"\"Read-only lineage audit. No transformation or strategy imports.\"\"\"\nimport hashlib\nimport json\nfrom collections import Counter\nfrom datetime import datetime, time, timedelta, timezone\nfrom pathlib import Path\nfrom zoneinfo import ZoneInfo\n\nROOT = Path('/workspace/scratch/889b77c10552')\nREPO = ROOT / 'agicore-d003-bundle-audit-main'\nPARENT = ROOT / 'upload/MNQ 09-26.Last.txt'\nDERIVED = ROOT / 'transformation-execution/MNQ_09-26_DEVELOPMENT_CANONICAL_V1.Last.txt'\nPARENT_HASH = '6e20320e06184673c745c1069753c77151fdccd4505b863210f6d63f3ff5fcd5'\nDERIVED_HASH = 'ee6eeed4871947b1fabe3c85bf4b5b319dc0d68e86edec7d2000815e22b2a126'\nCT = ZoneInfo('America/Chicago')\n\ndef digest(b):\n    return hashlib.sha256(b).hexdigest()\n\ndef iso(t):\n    return t.isoformat().replace('+00:00', 'Z')\n\ndef parse(line):\n    return datetime.strptime(line.split(b';', 1)[0].decode('ascii'), '%Y%m%d %H%M%S').replace(tzinfo=timezone.utc)\n\ndef scheduled_eob(t):\n    c = t.astimezone(CT)\n    d = c.date().isoformat()\n    tod = c.time()\n    if d in ('2026-06-19', '2026-07-03'):\n        return tod <= time(12), 'HOLIDAY_EARLY_CLOSE_AND_WEEKEND'\n    if d == '2026-09-07':\n        return tod <= time(12) or tod > time(17), 'HOLIDAY_NOON_TO_1700_HALT'\n    if c.weekday() == 5:\n        return False, 'SATURDAY_CLOSED'\n    if c.weekday() == 6:\n        return tod > time(17), 'SUNDAY_OPENS_1700_CT'\n    if c.weekday() == 4:\n        return tod <= time(16), 'FRIDAY_CLOSES_1600_CT'\n    return tod <= time(16) or tod > time(17), 'DAILY_1600_TO_1700_HALT'\n\ndef classify(g):\n    p, n = g['previous_timestamp_utc'], g['next_timestamp_utc']\n    pt = datetime.fromisoformat(p.replace('Z', '+00:00')).astimezone(CT)\n    nt = datetime.fromisoformat(n.replace('Z', '+00:00')).astimezone(CT)\n    if pt.date() == nt.date() and pt.time() == time(16) and nt.time() == time(17, 1) and pt.weekday() < 4:\n        return 'SCHEDULED_DAILY_MAINTENANCE_PRESERVED', ['CME_REGULAR_EQUITY_HOURS'], []\n    if pt.weekday() == 4 and pt.time() == time(16) and nt.weekday() == 6 and nt.time() == time(17, 1) and (nt.date() - pt.date()).days == 2:\n        return 'SCHEDULED_WEEKEND_CLOSURE_PRESERVED', ['CME_REGULAR_EQUITY_HOURS'], []\n    if p == '2026-06-19T17:00:00Z' and n == '2026-06-21T22:01:00Z':\n        return 'SCHEDULED_HOLIDAY_WEEKEND_CLOSURE_PRESERVED', ['NT_2026_EQUITY_HOLIDAY_HOURS'], []\n    if p == '2026-07-03T17:00:00Z' and n == '2026-07-04T14:40:00Z':\n        return 'SCHEDULED_HOLIDAY_WEEKEND_CLOSURE_PRESERVED', ['NT_2026_EQUITY_HOLIDAY_HOURS'], ['NEXT_OBSERVED_ROW_OUTSIDE_PUBLISHED_SESSION']\n    if p == '2026-07-04T14:40:00Z' and n == '2026-07-05T22:01:00Z':\n        return 'SCHEDULED_HOLIDAY_WEEKEND_CLOSURE_PRESERVED', ['NT_2026_EQUITY_HOLIDAY_HOURS'], ['PREVIOUS_OBSERVED_ROW_OUTSIDE_PUBLISHED_SESSION']\n    if p == '2026-09-07T17:00:00Z' and n == '2026-09-07T22:01:00Z':\n        return 'SCHEDULED_HOLIDAY_EARLY_CLOSE_PRESERVED', ['NT_2026_EQUITY_HOLIDAY_HOURS'], []\n    return 'UNEXPECTED_DATA_GAP_PRESERVED', ['CME_REGULAR_EQUITY_HOURS', 'NT_2026_EQUITY_HOLIDAY_HOURS'], []\n\nparent_bytes = PARENT.read_bytes()\nderived_bytes = DERIVED.read_bytes()\nassert (digest(parent_bytes), len(parent_bytes)) == (PARENT_HASH, 5416523)\nassert (digest(derived_bytes), len(derived_bytes)) == (DERIVED_HASH, 4785270)\nplines, dlines = parent_bytes.splitlines(keepends=True), derived_bytes.splitlines(keepends=True)\nassert (len(plines), len(dlines)) == (101962, 89841)\nassert plines[12120:101961] == dlines\ntimestamps = [parse(line) for line in dlines]\nassert iso(timestamps[0]) == '2026-06-18T22:01:00Z'\nassert iso(timestamps[-1]) == '2026-09-18T13:30:00Z'\nassert all(t.second == 0 and t.microsecond == 0 for t in timestamps)\nassert all(b > a for a, b in zip(timestamps, timestamps[1:]))\nactual_gaps = []\nfor a, b in zip(timestamps, timestamps[1:]):\n    elapsed = int((b-a).total_seconds())\n    if elapsed > 60:\n        actual_gaps.append({'previous_timestamp_utc': iso(a), 'next_timestamp_utc': iso(b), 'elapsed_seconds': elapsed, 'missing_minute_slots': elapsed // 60 - 1})\nreceipt = json.loads((REPO/'docs/evidence/EMA_PULLBACK_V2_DEVELOPMENT_DATASET_TRANSFORMATION_EXECUTION.json').read_bytes())\nprior_gaps = [{k: g[k] for k in ('previous_timestamp_utc', 'next_timestamp_utc', 'elapsed_seconds', 'missing_minute_slots')} for g in receipt['independent_audit']['result']['derived']['gap_inventory']]\nassert actual_gaps == prior_gaps and len(actual_gaps) == 71\noff_session = []\nfor row, t in enumerate(timestamps, 1):\n    ok, why = scheduled_eob(t)\n    if not ok:\n        off_session.append({'derived_row_one_based': row, 'parent_row_one_based': row + 12120, 'timestamp_utc': iso(t), 'timestamp_chicago': t.astimezone(CT).isoformat(), 'calendar_reason': why, 'classification': 'OBSERVED_ROW_OUTSIDE_PUBLISHED_SESSION_UNRESOLVED', 'row_preserved_unchanged': True})\nclassified = []\nfor i, g in enumerate(actual_gaps, 1):\n    c, sources, flags = classify(g)\n    # Validate closure classifications against the published calendar, without\n    # creating, reconstructing, or inserting any price/volume bar.\n    first_missing = datetime.fromisoformat(g['previous_timestamp_utc'].replace('Z', '+00:00')) + timedelta(minutes=1)\n    calendar_valid_missing = sum(scheduled_eob(first_missing + timedelta(minutes=m))[0] for m in range(g['missing_minute_slots']))\n    if c.startswith('SCHEDULED_'):\n        assert calendar_valid_missing == 0\n    else:\n        assert calendar_valid_missing == g['missing_minute_slots']\n    classified.append({'gap_id': f'G{i:03d}', **g, 'classification': c, 'evidence_source_ids': sources, 'endpoint_flags': flags, 'mi